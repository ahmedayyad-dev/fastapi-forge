# Copy to .env and adjust. All variables use the FORGE_ prefix.

# --- Application ---
FORGE_APP_NAME=fastapi-forge
FORGE_ENVIRONMENT=local
FORGE_DEBUG=false
FORGE_API_V1_PREFIX=/api/v1

# --- Redis ---
FORGE_REDIS_URL=redis://localhost:6379/0
FORGE_REDIS_MAX_CONNECTIONS=20
FORGE_REDIS_SOCKET_TIMEOUT=5.0

# --- Cache ---
FORGE_CACHE_TTL_SECONDS=60

# --- Rate limiting ---
FORGE_RATE_LIMIT_REQUESTS=100
FORGE_RATE_LIMIT_WINDOW_SECONDS=60

# --- Distributed lock ---
FORGE_LOCK_TTL_SECONDS=30
FORGE_LOCK_BLOCKING_TIMEOUT_SECONDS=5.0
FORGE_LOCK_POLL_INTERVAL_SECONDS=0.1

# --- Logging ---
FORGE_LOG_LEVEL=INFO
FORGE_LOG_JSON=true

# --- Middleware ---
FORGE_REQUEST_ID_HEADER=X-Request-ID

# --- CORS (comma-separated, JSON list, or "*" for all --- dev only) ---
FORGE_CORS_ORIGINS=*
